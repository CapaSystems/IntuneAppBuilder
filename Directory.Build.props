<Project>
	<PropertyGroup>
		<SlnFiles>$([System.IO.Directory]::GetFiles('$(MSBuildThisFileDirectory)', '*.sln'))</SlnFiles>
		<SolutionName Condition="'$(SolutionName)' == ''">$([System.IO.Path]::GetFileNameWithoutExtension($(SlnFiles)))</SolutionName>
		<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>$(AssemblyName)</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<!-- https://github.com/SonarSource/sonar-dotnet/issues/2426 -->
		<NoWarn>$(NoWarn);AD0001</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<Repository>https://github.com/simeoncloud/IntuneAppBuilder</Repository>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!-- Set to false to bypass Microsoft.Build.Tasks.Git when runner git metadata causes errors -->
		<EnableSourceControlManagerQueries>true</EnableSourceControlManagerQueries>
	</PropertyGroup>
	<ItemGroup>
		<!-- Upgraded SourceLink to avoid Microsoft.Build.Tasks.Git parsing errors with newer git repository versions -->
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="$(MSBuildThisFileDirectory)AssemblyInfo.cs" />
	</ItemGroup>
</Project>